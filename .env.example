# Copie para .env e ajuste se precisar. Nenhum segredo entra no repositório.

# Onde fica o arquivo do banco. Em produção, fora da pasta do código.
PN_BANCO=dados/paginas_novas.db

# De quanto em quanto tempo os dashboards se atualizam sozinhos (segundos).
PN_INTERVALO_ATUALIZACAO=60

# Depois de quanto tempo parado a sessão expira (minutos).
PN_MINUTOS_INATIVIDADE=30
